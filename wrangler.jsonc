// Wrangler configuration — Akirma Events PLC (akirmaevents.com)
// Deploys via GitHub Actions (push to main) → npx wrangler deploy.
// The custom domain akirmaevents.com is attached to this Worker in the
// Cloudflare dashboard and is intentionally NOT managed here, so deploys
// never touch DNS or domain bindings.
//
// worker.js serves the static site + a small booking-inquiry API
// (POST /api/inquiry) backed by the KV namespace below. Inquiries appear
// in the admin dashboard at /admin.html.
//
// EMAIL ALERTS: every new booking inquiry triggers an email to NOTIFY_EMAIL
// via the SEND_EMAIL binding (Cloudflare Email Routing). The recipient must
// be a verified destination address (Email → Email Routing → Destination
// addresses) and Email Routing must be enabled for the zone — until then
// sends fail gracefully and bookings are never affected.
{
  "$schema": "https://json.schemastore.org/wrangler.jsonc",
  "name": "akirma",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "vars": {
    // Where booking alerts are sent (must be a verified destination address
    // in Cloudflare Email Routing before real delivery works).
    // akirmaevents24@gmail.com is verified. info@akirma.com CANNOT be used
    // for now: that domain's DNS (BlueNile Host nameservers) SERVFAILs
    // globally, so the Cloudflare verification email bounces. If akirma.com
    // DNS is ever fixed at BlueNile Host, re-add it as a destination address,
    // click the verification link, then set NOTIFY_EMAIL to "info@akirma.com".
    // Note: info@akirmaevents.com (public contact email) forwards to
    // akirmaevents24@gmail.com via Email Routing — alerts stay on the gmail
    // directly to keep one hop.
    "NOTIFY_EMAIL": "akirmaevents24@gmail.com",
    // Sender address for booking alerts — on this zone (Email Routing enabled),
    // so customer replies to alerts forward back to the gmail inbox too.
    "NOTIFY_FROM": "info@akirmaevents.com"
  },
  "send_email": [
    { "name": "SEND_EMAIL" }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "INQUIRIES",
      "id": "1e84a2f8bb124ac184b13303553011c5"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOGIN_GUARD",
        "class_name": "LoginGuard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LoginGuard"]
    }
  ]
}
