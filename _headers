# Cloudflare Workers static assets — cache rules.
# HTML pages intentionally keep the default max-age=0 (must-revalidate)
# so content changes appear immediately after every deploy.

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icons/*
  Cache-Control: public, max-age=2592000

/logo.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
